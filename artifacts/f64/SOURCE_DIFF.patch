+  def test_nan_inf_input_bytes_rejected(self):
+    s = self.api('source')
+    for word in (b'NaN', b'Infinity', b'-Infinity'):
+      with self.assertRaisesRegex(s.ContractError, '^F64_JSON$'):
+        s.decode_source(b'{"bad":' + word + b'}\n')
